# ── Mistral AI (LLM Reasoning, Summaries & RAG) ──
MISTRAL_API_KEY="your_mistral_api_key_here"
MISTRAL_MODEL="open-mistral-nemo"

# ── Sarvam AI (Speech-to-Text & Translation) ──
# Required on Streamlit Cloud for both English and Hinglish STT
SARVAM_API_KEY="your_sarvam_api_key_here"
SARVAM_STT_MODEL="saaras:v2.5"

# ── Whisper (Optional Local English STT) ──
# Used for offline local development if whisper is installed
WHISPER_MODEL="base"
USE_LOCAL_WHISPER="false"
